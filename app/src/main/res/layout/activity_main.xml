<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <CheckBox
            android:id="@+id/checkboxFetchRoles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dobavi uloge" />

        <CheckBox
            android:id="@+id/checkboxShowDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prikaži opis"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <Button
        android:id="@+id/buttonTakePicture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Slikaj"
        android:layout_marginBottom="16dp" />

    <ImageView
        android:id="@+id/imageViewPicture"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerInside"
        android:layout_marginBottom="16dp"
        android:background="#f0f0f0" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/textViewProximity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Proximity senzor: --"
            android:textSize="16sp"
            android:padding="8dp"
            android:background="#e0e0e0" />

    </ScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/textViewRoleDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Opis uloge će biti prikazan ovde"
            android:textSize="14sp"
            android:padding="8dp"
            android:background="#f9f9f9" />

    </ScrollView>

</LinearLayout>
